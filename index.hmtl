<!DOCTYPE html>
<html lang="fr">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dressing IA</title>

<link rel="stylesheet" href="style.css">

<link rel="manifest" href="manifest.json">

<meta name="theme-color" content="#f7f5f0">

</head>


<body>


<header>

Dressing IA

</header>




<section id="home" class="page active">


<div class="hero card">

👕 🧥 👖 👟

</div>



<div class="card">


<h2>
✨ Inspiration du jour
</h2>


<p id="daily">

Une tenue pensée pour toi.

</p>


<button onclick="generateOutfit()">

Créer une tenue

</button>


</div>



<div class="card">

<h2>
À redécouvrir
</h2>


<p>

Découvre des vêtements oubliés de ton dressing.

</p>


</div>



</section>







<section id="dressing" class="page">


<div class="card">


<div class="dress-header">


<h1>
Mon dressing
</h1>


<button onclick="toggleDeleteMode()">

🗑 Supprimer

</button>


</div>



<p>

Toutes tes pièces au même endroit.

</p>



<div id="deleteActions" style="display:none;">


<button onclick="deleteSelected()">

Supprimer les éléments sélectionnés

</button>


</div>



</div>





<div id="clothes">

</div>







<div class="card">


<h2>

➕ Ajouter un vêtement

</h2>




<input
type="file"
id="photo"
accept="image/*">





<input
id="name"
placeholder="Nom du vêtement">





<select id="category">


<option>Haut</option>

<option>Pantalon</option>

<option>Chaussure</option>

<option>Veste</option>

<option>Accessoire</option>


</select>





<input
id="brand"
placeholder="Marque">





<input
id="color"
placeholder="Couleur">





<select id="season">


<option>Printemps</option>

<option>Été</option>

<option>Automne</option>

<option>Hiver</option>


</select>





<button onclick="addClothing()">

Ajouter au dressing

</button>




</div>



</section>









<section id="create" class="page">


<div class="card">


<h1>

✨ Composer

</h1>



<div id="outfit">

Aucune tenue.

</div>



<br>



<button onclick="generateOutfit()">

Créer une tenue

</button>




<button onclick="likeOutfit()">

❤️ J'adore

</button>




</div>


</section>









<nav>


<button onclick="showPage('home')">

🏠

<br>

Accueil

</button>




<button onclick="showPage('dressing')">

👕

<br>

Dressing

</button>




<button onclick="showPage('create')">

✨

<br>

Créer

</button>



</nav>







<script src="script.js"></script>


</body>


</html>
